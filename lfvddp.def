# Singularity definition file for LFVNN-symmetrized project
# Using CERN CMS Cloud Python VNC image as base
Bootstrap: docker
From: gitlab-registry.cern.ch/cms-cloud/python-vnc:latest

%post
    set -eu

    # Cache-busting commit: PLACEHOLDER
    # Set default values for build arguments
    REPO_URL="${REPO_URL:-https://github.com/eladushiki/lfvddp.git}"
    BRANCH="${BRANCH:-main}"
    COMMIT_HASH="${COMMIT_HASH:-}"
    CONTAINER_PROJECT_ROOT="${CONTAINER_PROJECT_ROOT:-/app}"
    
    # Install additional system dependencies if needed
    apt-get update && apt-get install -y \
        libffi-dev \
        libssl-dev \
        && rm -rf /var/lib/apt/lists/*

    # Set working directory
    mkdir -p $CONTAINER_PROJECT_ROOT
    cd $CONTAINER_PROJECT_ROOT

    # Clone the repository using build arguments
    echo "Cloning repository: $REPO_URL (branch: $BRANCH)"
    git clone --branch "$BRANCH" --single-branch "$REPO_URL" .
    if [ -n "$COMMIT_HASH" ]; then
        git checkout --detach "$COMMIT_HASH"
    fi
    git submodule update --init --recursive

    # Source the project Python before creating its additive virtual environment.
    CVMFS_PYTHON_SETUP_PATH="$(python -c 'from frame.python_environment import CVMFS_PYTHON_SETUP_PATH; print(CVMFS_PYTHON_SETUP_PATH)')"
    UV_CACHE_DIR_OVERRIDE=""
    UV_CACHE_DIR="${UV_CACHE_DIR_OVERRIDE:-$(python -c 'from frame.python_environment import DEFAULT_UV_CACHE_DIR; print(DEFAULT_UV_CACHE_DIR)')}"
    export UV_CACHE_DIR
    source "$CVMFS_PYTHON_SETUP_PATH"
    python -m venv --system-site-packages "$CONTAINER_PROJECT_ROOT/.venv"
    source "$CONTAINER_PROJECT_ROOT/.venv/bin/activate"
    python -m pip install --no-cache-dir --upgrade uv
    python -m uv sync --locked --active

%environment
    export PYTHONPATH=/app
    CVMFS_PYTHON_SETUP_PATH="$(python -c 'from frame.python_environment import CVMFS_PYTHON_SETUP_PATH; print(CVMFS_PYTHON_SETUP_PATH)')"
    UV_CACHE_DIR="${UV_CACHE_DIR:-$(python -c 'from frame.python_environment import DEFAULT_UV_CACHE_DIR; print(DEFAULT_UV_CACHE_DIR)')}"
    export UV_CACHE_DIR
    source "$CVMFS_PYTHON_SETUP_PATH"
    source /app/.venv/bin/activate
    export PYTHONUNBUFFERED=1
    export TF_USE_LEGACY_KERAS=True

    if [ -d /cvmfs/atlas.cern.ch/repo/containers/sw/singularity/x86_64-el9/current/bin ]; then
        export PATH="/cvmfs/atlas.cern.ch/repo/containers/sw/singularity/x86_64-el9/current/bin:$PATH"
    fi

%test
    CVMFS_PYTHON_SETUP_PATH="$(PYTHONPATH=/app python -c 'from frame.python_environment import CVMFS_PYTHON_SETUP_PATH; print(CVMFS_PYTHON_SETUP_PATH)')"
    UV_CACHE_DIR="${UV_CACHE_DIR:-$(PYTHONPATH=/app python -c 'from frame.python_environment import DEFAULT_UV_CACHE_DIR; print(DEFAULT_UV_CACHE_DIR)')}"
    export UV_CACHE_DIR
    source "$CVMFS_PYTHON_SETUP_PATH"
    source /app/.venv/bin/activate
    python -m uv pip check
    python -c "import camel_converter; import train.single_train"

%runscript
    exec /bin/bash "$@"

%labels
    Author LFVNN-symmetrized project
    Version 1.0
    Description Symmetrized DDP research project infrastructure and tools

%help
    This container includes the LFVNN-symmetrized project with all dependencies.
    
    Example:
    set REPO_URL and BRANCH either from within script or by running through submit.py
    singularity build --remote lfvnn.sif lfvnn.def
    
    Usage:
    singularity run lfvnn.sif [command]
    singularity exec lfvnn.sif python train/single_train.py [args]
    
    To copy configs after building:
    singularity exec --bind /path/to/configs:/tmp/configs lfvnn.sif cp -r /tmp/configs /app/configs
    
    The container sets up the Python environment and clones the specified repository and branch.
